# Copy to .env and replace placeholders with YOUR Kalshi demo credentials.
# Starting the bot enables bounded demo exchange orders via config.yaml.
KALSHI_MODE=demo
KALSHI_DATA_MODE=demo
KALSHI_PAPER=0
KALSHI_API_KEY=your_demo_api_key_id
KALSHI_PRIVATE_KEY_PATH=C:/KalshiBot/demo-private-key.pem
DASHBOARD_PORT=5150
# Optional bearer token if exposing the dashboard through an authenticated proxy:
# DASHBOARD_TOKEN=choose_a_long_random_token
# Risk limits and strategy settings are in config.yaml.
# Production execution is rejected. Do not commit .env or private keys.
